FROM node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl unzip socat && rm -rf /var/lib/apt/lists/*
RUN npm install -g @opencode/cli@2.2.7
RUN curl -fsSL -o /tmp/godot.zip https://github.com/godotengine/godot/releases/download/4.3-stable/Godot_v4.3-stable_linux.x86_64.zip \
    && echo 'fd52bb4ba8acc30ca5accd1c566d470ad7282f891ccc0995dfafabcf92bcf76280ce182bf9d80ebd885f3ed2165d01e1fc3f2928436b15498dfbd98656c2a45a  /tmp/godot.zip' | sha512sum -c - \
    && unzip -q /tmp/godot.zip -d /opt/godot && rm /tmp/godot.zip
WORKDIR /project
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY AGENTS.md VISION.md ./
COPY .ai/cezar/workflows/ .ai/cezar/workflows/
COPY studio/ studio/
COPY game/ game/
ARG FIXTURE_CONFIG=opencode-fixture.json
COPY studio/fixtures/${FIXTURE_CONFIG} opencode.json
RUN mkdir -p /project/.npm-cache && cp -a /root/.npm/. /project/.npm-cache/ \
    && printf 'node_modules/\n.npm-cache/\n.test-tmp/\n.godot/\n.ai/cezar/runs/\n.ai/cezar/worktrees/\n.ai/cezar/runs.json\nideas/\n' > .gitignore \
    && git init -b main && git config user.name 'Fixture' && git config user.email 'fixture@example.invalid' \
    && git add . && git commit -m 'Fixture baseline' && mkdir -p ideas /handoff /project/.test-tmp \
    && chown -R node:node /project /handoff
USER node
ENV HOME=/tmp TMPDIR=/project/.test-tmp CEZ_HOME=/tmp/cezar FIXTURE_MODEL_KEY=fixture-client-placeholder CEZ_DRY_RUN=0 CEZ_AGENT_MODELS_LOCKED=1 CEZ_TELEMETRY=0 CEZ_RELAY=0 CEZ_OPENCODE_BIN=/usr/local/bin/opencode GODOT_BIN=/opt/godot/Godot_v4.3-stable_linux.x86_64 npm_config_cache=/project/.npm-cache npm_config_offline=true
CMD ["./node_modules/.bin/cezar", "--no-open", "--bind-host", "127.0.0.1", "--port", "14321"]
