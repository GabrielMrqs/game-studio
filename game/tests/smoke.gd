	press(tools, "Case File")
	var alternative_text: String = case_layout.get_child(0).text
	check("Closed — rectified" in alternative_text and "alternative continuity maintained" in alternative_text and "Eva rescued Paula" in alternative_text and "Ricardo Almeida" in alternative_text and "quietly shuts" in alternative_text and alternative_text != recognized_text, "alternative branch completes a distinct dossier and epilogue")
	press(case_layout, "Close")
	game.save_game()
	game.rectification = ""
	game.load_game()
	check(game.rectification == "alternative", "alternative decision survives save and load")
	press(game.hotspots, "← Observatory")
	press(game.hotspots, "Inspect delivery record")
	check("14 Harbour Road" in aurora_document.get_child(0).text, "observatory document remains available after Aurora")
	press(aurora_document, "Close")
	var bad := FileAccess.open(game.save_path, FileAccess.WRITE)
	bad.store_string("not json")
	bad.close()
	game.load_game()
	check(game.has_lens and game.room == "observatory", "invalid save preserves progress")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(game.save_path))
	game._new_game()
	check(game.rectification == "" and game.reconstruction_solved == [false, false] and game.intake_panel.visible, "new game resets the completed case for replay")
	game.queue_free()
	if failures == 0:
		print("PASS: dialogue, rooms, hotspots, inventory, puzzle and save/load")
	quit(1 if failures else 0)
