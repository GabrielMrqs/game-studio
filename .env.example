# Set these in the process environment; the prototype does not load .env itself.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_LABEL=studio
LINEAR_WEBHOOK_SECRET=
LINEAR_WEBHOOK_PORT=8787
LINEAR_POLL_SECONDS=60
STUDIO_INBOX=ideas
STUDIO_STATE=.studio-state
# Explicitly opt in only in an isolated, supervised test environment.
STUDIO_WORKFLOW=studio-plan
# Supplementary watchdog only; these do not guarantee a hard spending cap.
STUDIO_MAX_RUN_SECONDS=900
STUDIO_MAX_REPORTED_TOKENS=50000
CEZ_API_URL=http://127.0.0.1:4321
# Explicit operator-triggered publishing only; never commit real values.
GITHUB_REPO=
GITHUB_TOKEN=
